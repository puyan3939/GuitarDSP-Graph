{
  "name": "DS-1",
  "description": "Component-level engaged signal path for the post-1994 / dual-op-amp DS-1 family. Parity reference: guitardsp::circuit::DS1Circuit (include/guitardsp/circuit/DS1Circuit.h).",
  "ops": [
    { "op": "node", "name": "supply" },
    { "op": "node", "name": "vref" },
    { "op": "node", "name": "inputJack" },
    { "op": "node", "name": "inputSeries" },
    { "op": "node", "name": "q1Base" },
    { "op": "node", "name": "q1Emitter" },
    { "op": "node", "name": "firstHighPass" },
    { "op": "node", "name": "q2Base" },
    { "op": "node", "name": "q2Emitter" },
    { "op": "node", "name": "q2Collector" },
    { "op": "node", "name": "opAmpInput" },
    { "op": "node", "name": "opAmpBufferInv" },
    { "op": "node", "name": "opAmpBufferOut" },
    { "op": "node", "name": "gainInv" },
    { "op": "node", "name": "gainFeedbackGround" },
    { "op": "node", "name": "gainOut" },
    { "op": "node", "name": "clipCouplingInput" },
    { "op": "node", "name": "clipNode" },
    { "op": "node", "name": "toneHighPre" },
    { "op": "node", "name": "toneHigh" },
    { "op": "node", "name": "toneLow" },
    { "op": "node", "name": "toneWiperNode" },
    { "op": "node", "name": "levelWiper" },
    { "op": "node", "name": "levelPost" },
    { "op": "node", "name": "q3Base" },
    { "op": "node", "name": "q3Emitter" },
    { "op": "node", "name": "outputCouplingInput" },
    { "op": "node", "name": "outputNode" },

    { "op": "voltageSource", "name": "supplySource", "p": "supply", "n": "ground", "volts": 0.0 },
    { "op": "voltageSource", "name": "vrefSource", "p": "vref", "n": "ground", "volts": 0.0 },
    { "op": "voltageSource", "name": "inputSource", "p": "inputJack", "n": "ground", "volts": 0.0 },

    { "op": "resistor", "a": "inputJack", "b": "inputSeries", "ohms": 1000.0 },
    { "op": "capacitor", "a": "inputSeries", "b": "q1Base", "farads": 47.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "vref", "b": "q1Base", "ohms": 470000.0 },
    { "op": "bjtEbersMoll", "name": "inputBuffer", "collector": "supply", "base": "q1Base", "emitter": "q1Emitter",
      "preset": "2n5088",
      "overrides": { "name": "2SC2240-style", "beta": 350.0, "nominalVbe": 0.62, "saturationVoltage": 0.15,
                     "maxCollectorVoltage": 120.0, "maxCollectorCurrentAmps": 0.10, "inputCapacitanceFarads": 12.0e-12 } },
    { "op": "resistor", "a": "q1Emitter", "b": "ground", "ohms": 10000.0 },

    { "op": "capacitor", "a": "q1Emitter", "b": "firstHighPass", "farads": 470.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "firstHighPass", "b": "ground", "ohms": 100000.0 },
    { "op": "capacitor", "a": "firstHighPass", "b": "q2Base", "farads": 47.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "q2Base", "b": "ground", "ohms": 100000.0 },

    { "op": "resistor", "a": "supply", "b": "q2Collector", "ohms": 10000.0 },
    { "op": "resistor", "a": "q2Emitter", "b": "ground", "ohms": 22.0 },
    { "op": "resistor", "a": "q2Collector", "b": "q2Base", "ohms": 470000.0 },
    { "op": "capacitor", "a": "q2Collector", "b": "q2Base", "farads": 250.0e-12, "voltageRating": 50.0, "technology": "ceramic" },
    { "op": "bjtEbersMoll", "name": "booster", "collector": "q2Collector", "base": "q2Base", "emitter": "q2Emitter",
      "preset": "2n5088",
      "overrides": { "name": "2SC2240-style", "beta": 350.0, "nominalVbe": 0.62, "saturationVoltage": 0.15,
                     "maxCollectorVoltage": 120.0, "maxCollectorCurrentAmps": 0.10, "inputCapacitanceFarads": 12.0e-12 } },

    { "op": "capacitor", "a": "q2Collector", "b": "opAmpInput", "farads": 68.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "opAmpInput", "b": "vref", "ohms": 100000.0 },
    { "op": "diodeParasitic", "name": "inputProtection", "anode": "ground", "cathode": "opAmpInput",
      "preset": "1n4148", "overrides": { "name": "DS-1 op-amp input protection" } },

    { "op": "opAmp", "output": "opAmpBufferOut", "nonInverting": "opAmpInput", "inverting": "opAmpBufferInv", "reference": "ground",
      "spec": { "name": "DS-1 NJM3404/NJM2904-style", "openLoopGainDb": 100.0, "gainBandwidthHz": 1.2e6,
                "slewRateVoltsPerSecond": 0.5e6, "inputBiasCurrentAmps": 40.0e-9, "inputOffsetVoltage": 2.0e-3,
                "inputNoiseVoltsPerRootHz": 40.0e-9, "outputCurrentLimitAmps": 0.020,
                "positiveRailHeadroomVolts": 1.5, "negativeRailHeadroomVolts": 0.05, "outputResistanceOhms": 50.0 } },
    { "op": "resistor", "a": "opAmpBufferOut", "b": "opAmpBufferInv", "ohms": 100000.0 },

    { "op": "dynamicOpAmp", "name": "gainOpAmp", "output": "gainOut", "nonInverting": "opAmpBufferOut", "inverting": "gainInv",
      "positiveRail": "supply", "negativeRail": "ground", "reference": "ground",
      "spec": { "name": "DS-1 NJM3404/NJM2904-style", "openLoopGainDb": 100.0, "gainBandwidthHz": 1.2e6,
                "slewRateVoltsPerSecond": 0.5e6, "inputBiasCurrentAmps": 40.0e-9, "inputOffsetVoltage": 2.0e-3,
                "inputNoiseVoltsPerRootHz": 40.0e-9, "outputCurrentLimitAmps": 0.020,
                "positiveRailHeadroomVolts": 1.5, "negativeRailHeadroomVolts": 0.05, "outputResistanceOhms": 50.0 } },
    { "op": "potentiometer", "name": "drivePot", "high": "gainInv", "wiper": "gainOut", "low": "gainOut",
      "ohms": 100000.0, "taper": "linear", "position": 0.45 },
    { "op": "capacitor", "a": "gainInv", "b": "gainOut", "farads": 100.0e-12, "voltageRating": 50.0, "technology": "ceramic" },
    { "op": "resistor", "a": "gainInv", "b": "gainFeedbackGround", "ohms": 4700.0 },
    { "op": "capacitor", "a": "gainFeedbackGround", "b": "ground", "farads": 470.0e-9, "voltageRating": 50.0, "technology": "film" },

    { "op": "resistor", "a": "gainOut", "b": "clipCouplingInput", "ohms": 2200.0 },
    { "op": "capacitor", "a": "clipCouplingInput", "b": "clipNode", "farads": 470.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "diodeParasitic", "name": "clippingPositive", "anode": "clipNode", "cathode": "ground",
      "preset": "1n4148", "overrides": { "name": "DS-1 1S1588/1S2473/1N4148-style" } },
    { "op": "diodeParasitic", "name": "clippingNegative", "anode": "ground", "cathode": "clipNode",
      "preset": "1n4148", "overrides": { "name": "DS-1 1S1588/1S2473/1N4148-style" } },
    { "op": "capacitor", "a": "clipNode", "b": "ground", "farads": 10.0e-9, "voltageRating": 50.0, "technology": "film" },

    { "op": "capacitor", "a": "clipNode", "b": "toneHighPre", "farads": 22.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "toneHighPre", "b": "toneHigh", "ohms": 2200.0 },
    { "op": "resistor", "a": "toneHigh", "b": "ground", "ohms": 6800.0 },
    { "op": "resistor", "a": "clipNode", "b": "toneLow", "ohms": 6800.0 },
    { "op": "capacitor", "a": "toneLow", "b": "ground", "farads": 100.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "potentiometer", "name": "tonePot", "high": "toneHigh", "wiper": "toneWiperNode", "low": "toneLow",
      "ohms": 20000.0, "taper": "linear", "position": 0.50 },

    { "op": "potentiometer", "name": "levelPot", "high": "toneWiperNode", "wiper": "levelWiper", "low": "ground",
      "ohms": 100000.0, "taper": "linear", "position": 0.55 },

    { "op": "resistor", "a": "levelWiper", "b": "levelPost", "ohms": 10000.0 },
    { "op": "resistor", "a": "levelPost", "b": "ground", "ohms": 1000000.0 },
    { "op": "capacitor", "a": "levelPost", "b": "q3Base", "farads": 47.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "vref", "b": "q3Base", "ohms": 1000000.0 },
    { "op": "bjtEbersMoll", "name": "outputBuffer", "collector": "supply", "base": "q3Base", "emitter": "q3Emitter",
      "preset": "2n5088",
      "overrides": { "name": "2SC2240-style", "beta": 350.0, "nominalVbe": 0.62, "saturationVoltage": 0.15,
                     "maxCollectorVoltage": 120.0, "maxCollectorCurrentAmps": 0.10, "inputCapacitanceFarads": 12.0e-12 } },
    { "op": "resistor", "a": "q3Emitter", "b": "ground", "ohms": 10000.0 },
    { "op": "resistor", "a": "q3Emitter", "b": "outputCouplingInput", "ohms": 1000.0 },
    { "op": "capacitor", "a": "outputCouplingInput", "b": "outputNode", "farads": 1.0e-6, "voltageRating": 50.0, "technology": "electrolytic" },
    { "op": "resistor", "a": "outputNode", "b": "ground", "ohms": 100000.0 }
  ],
  "ports": { "input": "inputSource", "supply": "supplySource", "vref": "vrefSource", "output": "outputNode" },
  "controls": {
    "distortion": { "pot": "drivePot", "invert": true },
    "tone": { "pot": "tonePot", "invert": false },
    "level": { "pot": "levelPot", "invert": false }
  },
  "simulation": {
    "sourceSteps": 128,
    "solvesPerStep": 2,
    "nonlinearResidualTolerance": 2.0e-5,
    "newtonMaxIterations": 40,
    "newtonTolerance": 2.0e-5,
    "supplyVolts": 9.0,
    "vrefVolts": 4.5
  }
}
