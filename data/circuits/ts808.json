{
  "name": "TS808",
  "description": "Component-level engaged TS808 audio path. Parity reference: guitardsp::circuit::TS808Circuit (include/guitardsp/circuit/TS808Circuit.h).",
  "ops": [
    { "op": "node", "name": "supply" },
    { "op": "node", "name": "vref" },
    { "op": "node", "name": "inputJack" },
    { "op": "node", "name": "inputCoupled" },
    { "op": "node", "name": "q1Base" },
    { "op": "node", "name": "q1Emitter" },
    { "op": "node", "name": "clipNonInv" },
    { "op": "node", "name": "clipInv" },
    { "op": "node", "name": "clipHpNode" },
    { "op": "node", "name": "clipFeedbackNode" },
    { "op": "node", "name": "clipOut" },
    { "op": "node", "name": "toneNonInv" },
    { "op": "node", "name": "toneInv" },
    { "op": "node", "name": "toneWiperNode" },
    { "op": "node", "name": "toneRcNode" },
    { "op": "node", "name": "toneOut" },
    { "op": "node", "name": "levelFeed" },
    { "op": "node", "name": "levelTop" },
    { "op": "node", "name": "levelWiper" },
    { "op": "node", "name": "q3Base" },
    { "op": "node", "name": "q3Emitter" },
    { "op": "node", "name": "outputCouplingInput" },
    { "op": "node", "name": "outputNode" },

    { "op": "voltageSource", "name": "supplySource", "p": "supply", "n": "ground", "volts": 0.0 },
    { "op": "voltageSource", "name": "vrefSource", "p": "vref", "n": "ground", "volts": 0.0 },
    { "op": "voltageSource", "name": "inputSource", "p": "inputJack", "n": "ground", "volts": 0.0 },

    { "op": "capacitor", "a": "inputJack", "b": "inputCoupled", "farads": 22.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "inputCoupled", "b": "q1Base", "ohms": 1000.0 },
    { "op": "resistor", "a": "vref", "b": "q1Base", "ohms": 510000.0 },
    { "op": "bjtEbersMoll", "name": "inputBuffer", "collector": "supply", "base": "q1Base", "emitter": "q1Emitter",
      "preset": "2n3904",
      "overrides": { "name": "2SC1815-style", "beta": 350.0, "nominalVbe": 0.62, "saturationVoltage": 0.15,
                     "maxCollectorVoltage": 50.0, "maxCollectorCurrentAmps": 0.15, "inputCapacitanceFarads": 8.0e-12 } },
    { "op": "resistor", "a": "q1Emitter", "b": "ground", "ohms": 10000.0 },
    { "op": "capacitor", "a": "q1Emitter", "b": "clipNonInv", "farads": 1.0e-6, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "clipNonInv", "b": "vref", "ohms": 10000.0 },

    { "op": "dynamicOpAmp", "name": "clipOpAmp", "output": "clipOut", "nonInverting": "clipNonInv", "inverting": "clipInv",
      "positiveRail": "supply", "negativeRail": "ground", "reference": "ground",
      "preset": "jrc4558", "overrides": { "name": "TS808 JRC4558-style" } },
    { "op": "capacitor", "a": "clipInv", "b": "clipHpNode", "farads": 47.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "clipHpNode", "b": "ground", "ohms": 4700.0 },
    { "op": "resistor", "a": "clipInv", "b": "clipFeedbackNode", "ohms": 51000.0 },
    { "op": "potentiometer", "name": "drivePot", "high": "clipFeedbackNode", "wiper": "clipOut", "low": "clipOut",
      "ohms": 500000.0, "taper": "audio", "position": 0.55 },

    { "op": "diodeParasitic", "name": "clippingDiodePositive", "anode": "clipInv", "cathode": "clipOut",
      "preset": "1n4148", "overrides": { "name": "TS808 1N914/1N4148-style" } },
    { "op": "diodeParasitic", "name": "clippingDiodeNegative", "anode": "clipOut", "cathode": "clipInv",
      "preset": "1n4148", "overrides": { "name": "TS808 1N914/1N4148-style" } },
    { "op": "capacitor", "a": "clipInv", "b": "clipOut", "farads": 51.0e-12, "voltageRating": 50.0, "technology": "ceramic" },

    { "op": "resistor", "a": "clipOut", "b": "toneNonInv", "ohms": 1000.0 },
    { "op": "capacitor", "a": "toneNonInv", "b": "ground", "farads": 220.0e-9, "voltageRating": 35.0, "technology": "film" },
    { "op": "resistor", "a": "toneNonInv", "b": "vref", "ohms": 10000.0 },
    { "op": "potentiometer", "name": "tonePot", "high": "toneNonInv", "wiper": "toneWiperNode", "low": "toneInv",
      "ohms": 20000.0, "taper": "linear", "position": 0.50 },
    { "op": "capacitor", "a": "toneWiperNode", "b": "toneRcNode", "farads": 220.0e-9, "voltageRating": 35.0, "technology": "film" },
    { "op": "resistor", "a": "toneRcNode", "b": "ground", "ohms": 220.0 },
    { "op": "resistor", "a": "toneOut", "b": "toneInv", "ohms": 1000.0 },
    { "op": "opAmp", "output": "toneOut", "nonInverting": "toneNonInv", "inverting": "toneInv", "reference": "ground",
      "preset": "jrc4558", "overrides": { "name": "TS808 JRC4558-style" } },

    { "op": "capacitor", "a": "toneOut", "b": "levelFeed", "farads": 1.0e-6, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "levelFeed", "b": "levelTop", "ohms": 1000.0 },
    { "op": "potentiometer", "name": "levelPot", "high": "levelTop", "wiper": "levelWiper", "low": "ground",
      "ohms": 100000.0, "taper": "audio", "position": 0.55 },

    { "op": "capacitor", "a": "levelWiper", "b": "q3Base", "farads": 100.0e-9, "voltageRating": 50.0, "technology": "film" },
    { "op": "resistor", "a": "vref", "b": "q3Base", "ohms": 510000.0 },
    { "op": "bjtEbersMoll", "name": "outputBuffer", "collector": "supply", "base": "q3Base", "emitter": "q3Emitter",
      "preset": "2n3904",
      "overrides": { "name": "2SC1815-style", "beta": 350.0, "nominalVbe": 0.62, "saturationVoltage": 0.15,
                     "maxCollectorVoltage": 50.0, "maxCollectorCurrentAmps": 0.15, "inputCapacitanceFarads": 8.0e-12 } },
    { "op": "resistor", "a": "q3Emitter", "b": "ground", "ohms": 10000.0 },
    { "op": "resistor", "a": "q3Emitter", "b": "outputCouplingInput", "ohms": 100.0 },
    { "op": "capacitor", "a": "outputCouplingInput", "b": "outputNode", "farads": 10.0e-6, "voltageRating": 16.0, "technology": "electrolytic" },
    { "op": "resistor", "a": "outputNode", "b": "ground", "ohms": 10000.0 }
  ],
  "ports": { "input": "inputSource", "supply": "supplySource", "vref": "vrefSource", "output": "outputNode" },
  "controls": {
    "drive": { "pot": "drivePot", "invert": true },
    "tone": { "pot": "tonePot", "invert": true },
    "level": { "pot": "levelPot", "invert": false }
  },
  "simulation": {
    "sourceSteps": 128,
    "solvesPerStep": 2,
    "warmupSecondsFraction": 0.08,
    "warmupMinSamples": 512,
    "warmupMaxSamples": 8192,
    "nonlinearResidualTolerance": 2.0e-5,
    "newtonMaxIterations": 40,
    "newtonTolerance": 2.0e-5,
    "supplyVolts": 9.0,
    "vrefVolts": 4.5
  }
}
